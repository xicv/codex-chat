{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chat.invalid/schemas/collab-context-manifest-v2.schema.json",
  "title": "COLLAB_CONTEXT_MANIFEST_V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "protocolVersion",
    "rootLabel",
    "planSha256",
    "routing",
    "checkpointNamespace",
    "parent",
    "checkpoint",
    "representations"
  ],
  "properties": {
    "kind": { "const": "COLLAB_CONTEXT_MANIFEST_V2" },
    "protocolVersion": { "const": 2 },
    "rootLabel": { "type": "string", "minLength": 1 },
    "planSha256": { "$ref": "#/$defs/sha256" },
    "routing": { "$ref": "#/$defs/routing" },
    "checkpointNamespace": { "$ref": "#/$defs/id" },
    "parent": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contextSha256", "turnId"],
          "properties": {
            "contextSha256": { "$ref": "#/$defs/sha256" },
            "turnId": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "invariants",
        "decisions",
        "unresolved",
        "verificationStatus"
      ],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "invariants": { "$ref": "#/$defs/stringList" },
        "decisions": { "$ref": "#/$defs/stringList" },
        "unresolved": { "$ref": "#/$defs/stringList" },
        "verificationStatus": {
          "enum": ["unverified", "partial", "verified"]
        }
      }
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/representation" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stringList": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "coordinatorId",
        "workUnitId",
        "agentId"
      ],
      "properties": {
        "workspaceId": { "$ref": "#/$defs/id" },
        "coordinatorId": { "$ref": "#/$defs/id" },
        "workUnitId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/id" }
      }
    },
    "locator": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["space", "value"],
          "properties": {
            "space": { "$ref": "#/$defs/id" },
            "value": { "type": "string", "minLength": 1, "maxLength": 4096 }
          }
        }
      ]
    },
    "transform": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "version", "parameters", "coverage", "truncated"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object" },
            "coverage": { "type": "string", "minLength": 1 },
            "truncated": { "type": "boolean" }
          }
        }
      ]
    },
    "textProperties": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["charset", "bom", "lineEndings"],
          "properties": {
            "charset": { "const": "utf-8" },
            "bom": { "type": "boolean" },
            "lineEndings": { "enum": ["none", "lf", "cr", "crlf", "mixed"] }
          }
        }
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "modelVisible",
        "transport",
        "conversationIdentity",
        "turnId",
        "providerAttachmentId",
        "providerFingerprint"
      ],
      "properties": {
        "status": { "const": "staged" },
        "modelVisible": { "const": "unknown" },
        "transport": { "type": "null" },
        "conversationIdentity": { "type": "null" },
        "turnId": { "type": "null" },
        "providerAttachmentId": { "type": "null" },
        "providerFingerprint": { "type": "null" }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representationId",
        "path",
        "modality",
        "mediaType",
        "role",
        "purpose",
        "bytes",
        "sha256",
        "fidelity",
        "sourceRepresentationId",
        "sourceSha256",
        "locator",
        "transform",
        "text",
        "delivery"
      ],
      "properties": {
        "representationId": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "modality": {
          "enum": [
            "code",
            "text",
            "image",
            "pdf",
            "document",
            "spreadsheet",
            "data"
          ]
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
        },
        "role": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "fidelity": { "enum": ["exact", "lossless", "lossy"] },
        "sourceRepresentationId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/id" }
          ]
        },
        "sourceSha256": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "locator": { "$ref": "#/$defs/locator" },
        "transform": { "$ref": "#/$defs/transform" },
        "text": { "$ref": "#/$defs/textProperties" },
        "delivery": { "$ref": "#/$defs/delivery" }
      }
    }
  }
}
