{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chat.invalid/schemas/collab-result-v1.schema.json",
  "title": "COLLAB_RESULT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "protocolVersion", "runId", "turnId", "contextSha256", "complete", "artifactKind", "summary", "claims"],
  "properties": {
    "kind": { "const": "COLLAB_RESULT_V1" },
    "protocolVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "minLength": 1 },
    "contextSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "complete": { "const": true },
    "artifactKind": { "enum": ["patch", "advisory"] },
    "summary": { "type": "string" },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "content"],
      "properties": {
        "format": { "const": "unified-diff" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "content": { "type": "string" }
      }
    },
    "preimages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "claims": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "artifactKind": { "const": "patch" } },
        "required": ["artifactKind"]
      },
      "then": { "required": ["patch", "preimages"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["patch"] },
            { "required": ["preimages"] }
          ]
        }
      }
    }
  ]
}
