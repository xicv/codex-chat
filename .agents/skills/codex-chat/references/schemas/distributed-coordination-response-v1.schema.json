{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chat.invalid/schemas/distributed-coordination-response-v1.schema.json",
  "title": "CODEX_CHAT_DISTRIBUTED_COORDINATION_RESPONSE_V1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "data"],
      "properties": {
        "schema": { "const": "codex-chat/control/v1" },
        "ok": { "const": true },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sequence", "idempotent", "result"],
          "properties": {
            "sequence": { "type": "integer", "minimum": 0 },
            "idempotent": { "type": "boolean" },
            "result": {}
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "ok", "error"],
      "properties": {
        "schema": { "const": "codex-chat/control/v1" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "details": {}
          }
        }
      }
    }
  ]
}
