{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xicv/localci-bridge/schemas/job-v1.schema.json",
  "title": "LocalCI Bridge job v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "created_at",
    "source",
    "target",
    "task_type",
    "mode",
    "priority",
    "instructions",
    "acceptance_criteria",
    "allowed_paths",
    "verification_profile",
    "timeout_minutes",
    "publish"
  ],
  "properties": {
    "schema": {
      "const": "localci-bridge/job/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^(?!.*--)[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$",
      "minLength": 8,
      "maxLength": 80
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject",
        "sender_alias",
        "received_at",
        "summary"
      ],
      "properties": {
        "kind": {
          "enum": [
            "gmail",
            "github",
            "manual"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sender_alias": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9 ._-]*$"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_sha",
        "default_branch"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "default_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      }
    },
    "task_type": {
      "enum": [
        "triage-report",
        "draft-pr"
      ]
    },
    "mode": {
      "enum": [
        "read-only",
        "workspace-write"
      ]
    },
    "priority": {
      "enum": [
        "regression",
        "security",
        "bug",
        "performance",
        "feature",
        "documentation"
      ]
    },
    "instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 0,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "verification_profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "timeout_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 120
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_draft_pr",
        "merge",
        "deploy",
        "release"
      ],
      "properties": {
        "target_draft_pr": {
          "type": "boolean"
        },
        "merge": {
          "const": false
        },
        "deploy": {
          "const": false
        },
        "release": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "draft-pr"
          }
        },
        "required": [
          "task_type"
        ]
      },
      "then": {
        "properties": {
          "publish": {
            "properties": {
              "target_draft_pr": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "triage-report"
          }
        },
        "required": [
          "task_type"
        ]
      },
      "then": {
        "properties": {
          "publish": {
            "properties": {
              "target_draft_pr": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
