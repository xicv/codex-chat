{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chat.invalid/schemas/terminal-capture-receipt-v1.schema.json",
  "title": "CODEX_CHAT_TERMINAL_CAPTURE_RECEIPT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "protocolVersion",
    "slotId",
    "bindings",
    "capture",
    "resultEnvelope",
    "receiptId"
  ],
  "properties": {
    "kind": { "const": "CODEX_CHAT_TERMINAL_CAPTURE_RECEIPT_V1" },
    "protocolVersion": { "const": 1 },
    "slotId": { "$ref": "#/$defs/sha256" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "turnId",
        "contextSha256",
        "taskEnvelopeSha256",
        "outboundBindingVersion",
        "routing",
        "providerNamespace",
        "conversationIdentity",
        "terminalMarker",
        "providerMessageFingerprint"
      ],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "turnId": { "$ref": "#/$defs/id" },
        "contextSha256": { "$ref": "#/$defs/sha256" },
        "taskEnvelopeSha256": { "$ref": "#/$defs/sha256" },
        "outboundBindingVersion": { "const": 2 },
        "routing": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/routing" }
          ]
        },
        "providerNamespace": { "$ref": "#/$defs/id" },
        "conversationIdentity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "terminalMarker": { "type": "string", "minLength": 1 },
        "providerMessageFingerprint": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectPath", "sha256", "bytes", "state", "truncated"],
      "properties": {
        "objectPath": {
          "type": "string",
          "pattern": "^objects/[a-f0-9]{64}\\.response\\.txt$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        },
        "state": { "const": "terminal" },
        "truncated": { "const": false }
      }
    },
    "resultEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectPath", "sha256", "bytes"],
      "properties": {
        "objectPath": {
          "type": "string",
          "pattern": "^objects/[a-f0-9]{64}\\.result\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      }
    },
    "resultValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "errorCode"],
      "properties": {
        "status": { "const": "rejected" },
        "errorCode": {
          "type": "string",
          "pattern": "^RESULT_[A-Z0-9_]+$"
        }
      }
    },
    "receiptId": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "coordinatorId",
        "workUnitId",
        "agentId"
      ],
      "properties": {
        "workspaceId": { "$ref": "#/$defs/id" },
        "coordinatorId": { "$ref": "#/$defs/id" },
        "workUnitId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
