{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chat.invalid/schemas/transport-recovery-plan-v1.schema.json",
  "title": "CODEX_CHAT_TRANSPORT_RECOVERY_PLAN_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "protocolVersion",
    "runHead",
    "routing",
    "mode",
    "sendAllowed",
    "resendAllowed",
    "markerReconciliationRequired",
    "conclusiveMarkerAbsenceMayReturnToController",
    "observationsAllowed",
    "outbound",
    "conversationLeases",
    "allowedLedgerEvents",
    "forbiddenTransportActions",
    "nextAction"
  ],
  "properties": {
    "kind": { "const": "CODEX_CHAT_TRANSPORT_RECOVERY_PLAN_V1" },
    "protocolVersion": { "const": 1 },
    "runHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "eventSequence", "eventHash", "phase"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "eventSequence": { "type": "integer", "minimum": 1 },
        "eventHash": { "$ref": "#/$defs/sha256" },
        "phase": { "type": "string", "minLength": 1 }
      }
    },
    "routing": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/routing" }
      ]
    },
    "mode": { "enum": ["read-only", "terminal"] },
    "sendAllowed": { "const": false },
    "resendAllowed": { "const": false },
    "markerReconciliationRequired": { "type": "boolean" },
    "conclusiveMarkerAbsenceMayReturnToController": { "type": "boolean" },
    "observationsAllowed": { "type": "boolean" },
    "outbound": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "turnId",
            "marker",
            "expectedTerminalMarker",
            "providerNamespace",
            "conversationIdentity",
            "locator"
          ],
          "properties": {
            "turnId": { "type": "string", "minLength": 1 },
            "marker": { "type": "string", "minLength": 1 },
            "expectedTerminalMarker": { "type": "string", "minLength": 1 },
            "providerNamespace": {
              "oneOf": [
                { "type": "null" },
                { "$ref": "#/$defs/id" }
              ]
            },
            "conversationIdentity": { "type": "string", "minLength": 1 },
            "locator": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "value"],
                  "properties": {
                    "type": { "$ref": "#/$defs/id" },
                    "value": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "conversationLeases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerNamespace", "type", "value"],
        "properties": {
          "providerNamespace": { "$ref": "#/$defs/id" },
          "type": { "$ref": "#/$defs/id" },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowedLedgerEvents": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbiddenTransportActions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nextAction": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "coordinatorId",
        "workUnitId",
        "agentId"
      ],
      "properties": {
        "workspaceId": { "$ref": "#/$defs/id" },
        "coordinatorId": { "$ref": "#/$defs/id" },
        "workUnitId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
