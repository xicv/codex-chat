{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex-chat.invalid/schemas/verify-plan-v1.schema.json",
  "title": "CODEX_CHAT_VERIFY_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "protocolVersion", "cwd", "sourceRoot", "scratchRoot", "argv", "timeoutMs", "evidenceClass"],
  "properties": {
    "kind": { "const": "CODEX_CHAT_VERIFY_V1" },
    "protocolVersion": { "const": 1 },
    "cwd": { "type": "string", "minLength": 1 },
    "sourceRoot": { "type": "string", "minLength": 1 },
    "scratchRoot": { "type": "string", "minLength": 1 },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 8192 }
    },
    "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
    "evidenceClass": { "type": "string", "minLength": 1 },
    "env": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "turnId",
        "contextSha256",
        "workspaceId",
        "coordinatorId",
        "workUnitId",
        "agentId",
        "gateId",
        "applicationKey",
        "postimageSha256"
      ],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "turnId": { "$ref": "#/$defs/id" },
        "contextSha256": { "$ref": "#/$defs/sha256" },
        "workspaceId": { "$ref": "#/$defs/id" },
        "coordinatorId": { "$ref": "#/$defs/id" },
        "workUnitId": { "$ref": "#/$defs/id" },
        "agentId": { "$ref": "#/$defs/id" },
        "gateId": { "$ref": "#/$defs/id" },
        "applicationKey": { "$ref": "#/$defs/sha256" },
        "postimageSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
